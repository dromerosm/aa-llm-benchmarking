{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aa-llm-benchmarking",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "UPSTREAM_BUDGET",
        "class_name": "UpstreamBudgetCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UpstreamBudgetCoordinator"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
